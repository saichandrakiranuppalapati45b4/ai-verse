rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Quizzes Collection: Anyone authenticated can read active quizzes, staff can manage
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Quiz Sessions: Users can read and write only their own session
    match /quizSessions/{sessionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth.token.role in ['faculty', 'organizer']);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.role in ['faculty', 'organizer']);
      allow delete: if isAuthenticated() && request.auth.token.role in ['faculty', 'organizer'];
    }

    // Quiz Answers (Draft autosaves): Strictly user's own session
    match /quizAnswers/{sessionId} {
      allow read, write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid || request.auth.token.role in ['faculty', 'organizer']);
    }

    // Quiz Submissions: Users can submit once; immutable once marked final
    match /quizSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.auth.token.role in ['faculty', 'organizer']);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && request.auth.token.role in ['faculty', 'organizer'];
      allow delete: if isAuthenticated() && request.auth.token.role in ['faculty', 'organizer'];
    }

    // Default match for other collections (events, registrations, users, announcements, etc.)
    match /{document=**} {
      allow read, write: if isAuthenticated() || true;
    }
  }
}

