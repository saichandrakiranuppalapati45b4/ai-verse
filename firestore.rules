rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Quizzes & Examinations
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    match /quizSessions/{sessionId} {
      allow read, write: if true;
    }

    match /quizAnswers/{sessionId} {
      allow read, write: if true;
    }

    match /quizSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Events & Registrations
    match /events/{eventId} {
      allow read, write: if true;
    }

    match /registrations/{registrationId} {
      allow read, write: if true;
    }

    // Users & Team Members
    match /users/{userId} {
      allow read, write: if true;
    }

    match /organizers/{organizerId} {
      allow read, write: if true;
    }

    // Media & Gallery
    match /albums/{albumId} {
      allow read, write: if true;
    }

    match /gallery/{itemId} {
      allow read, write: if true;
    }

    // Attendance Management
    match /attendance/{recordId} {
      allow read, write: if true;
    }

    match /attendances/{recordId} {
      allow read, write: if true;
    }

    // Contact & Enquiries
    match /contact_queries/{queryId} {
      allow read, write: if true;
    }

    // Settings & Announcements
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Evaluations & Submissions
    match /evaluations/{evalId} {
      allow read, write: if true;
    }

    match /content/{contentId} {
      allow read, write: if true;
    }

  }
}
